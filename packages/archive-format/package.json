{
  "name": "@koharu-suite/archive-format",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned portable archive wire format and validators for koharu-suite.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.20.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tar-stream": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/tar-stream": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
