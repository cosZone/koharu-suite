{
  "name": "@coszone/koharu-astro",
  "version": "0.2.0",
  "description": "Typed Koharu Suite client and Astro 6/7 Live Content Collection loaders.",
  "keywords": [
    "astro",
    "astro-loader",
    "content-collections",
    "koharu",
    "telegram",
    "withastro"
  ],
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosZone/koharu-suite.git",
    "directory": "packages/koharu-astro"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./loaders": {
      "types": "./dist/loaders.d.ts",
      "import": "./dist/loaders.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "astro": "6.4.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
